  "orgId":"500000000000000004",
  "orgLegalName":"杜丽娅",
  "orgLegalIdNumber":"91310120MA1HKEMM1D",
  "licenceImage":"",
  "source":1,
  "channel":3
}




## 租客意愿签署相关接口
### 租客合同预览uid
# @name getContractUid
POST {{api-host}}/api-service-server/tapp/v1/contract/html-contract/{{tapp-contract-id}}
Content-Type: application/json
XXX-YUXIAOR-TOKEN: {{api-token}}
YXR-platform: h5

{
  "app": false,
  "version":"2"
}


### 租客合同预览html
@contractUid = {{getContractUid.response.body.$.data.uuid}}
GET {{api-host}}/api-service-server/common/v1/html/preview-content/{{contractUid}}
Content-Type: application/json
XXX-YUXIAOR-TOKEN: {{api-token}}
YXR-platform: h5

### 租客合同签署方式
GET {{api-host}}/api-service-server/tapp/v1/contract/sign-method?contractId={{tapp-contract-id}}
Content-Type: application/json
XXX-YUXIAOR-TOKEN: {{api-token}}
YXR-platform: h5


### 租客合同意愿签署url
# @name getWillingSignUrl
POST {{api-host}}/api-service-server/tapp/v1/contract/{{tapp-contract-id}}/willing-sign
Content-Type: application/json
XXX-YUXIAOR-TOKEN: {{api-token}}
YXR-platform: h5

{
  "redirectUrl":"https://www.yuxiaor.com",
  "wechatMiniProgram": true
}


### 租客意愿签署状态
GET {{api-host}}/api-service-server/tapp/v1/contract/{{tapp-contract-id}}/willing-sign/status
Content-Type: application/json
XXX-YUXIAOR-TOKEN: {{api-token}}
YXR-platform: h5


### 租客意愿签署确认
@flowId = {{getWillingSignUrl.response.body.$.data.flowId}}
GET {{api-host}}/api-service-server/tapp/v2/contract/saveHandSign/{{tapp-contract-id}}?flowId={{flowId}}
Content-Type: application/json
XXX-YUXIAOR-TOKEN: {{api-token}}
YXR-platform: h5


### 租客合同签署确认
POST {{api-host}}/api-service-server/tapp/v1/contract/pre/{{tapp-contract-id}}
Content-Type: application/json
XXX-YUXIAOR-TOKEN: {{api-token}}
YXR-platform: h5

{
  "version":"2"
}


## 公寓端相关接口
### 公寓端登录
# @name getYxrToken
POST {{yuxiaor-host}}/api/v1/sys/multi/userLogin
Content-Type: application/json
XXX-YUXIAOR-PC: pms

{"mobile":18573478892,"password":"123456","type":1}


### 公寓意愿签署任务列表
@yxr-token = {{getYxrToken.response.body.$.access_token}}
GET {{yuxiaor-host}}/api/v1/contract-willing-sign/tasks?signStatus=1
Content-Type: application/x-www-form-urlencoded
XXX-YUXIAOR-PC: pms
Xxx-Yuxiaor-Token: {{yxr-token}}


### 统计公寓意愿签署文件任务
@yxr-token = {{getYxrToken.response.body.$.access_token}}
GET {{yuxiaor-host}}/api/v1/contract-willing-sign/statistics
Content-Type: application/x-www-form-urlencoded
XXX-YUXIAOR-PC: pms
Xxx-Yuxiaor-Token: {{yxr-token}}


### 查询已开启意愿签署的个人签署主体
@yxr-token = {{getYxrToken.response.body.$.access_token}}
GET {{yuxiaor-host}}/api/v1/contract-willing-sign/personal-subjects
Content-Type: application/x-www-form-urlencoded
XXX-YUXIAOR-PC: pms
Xxx-Yuxiaor-Token: {{yxr-token}}


### 查询公寓本次意愿签署状态
@yxr-token = {{getYxrToken.response.body.$.access_token}}
GET {{yuxiaor-host}}/api/v1/contract-willing-sign/status?batchSignId=api-batch-sign-a0e8ad15fd0e4b8e89c4a885884b0a32
Content-Type: application/x-www-form-urlencoded
XXX-YUXIAOR-PC: pms
Xxx-Yuxiaor-Token: {{yxr-token}}


### 获取批量意愿签署URL
@yxr-token = {{getYxrToken.response.body.$.access_token}}
POST {{yuxiaor-host}}/api/v1/contract-willing-sign/batch-url
Content-Type: application/json
XXX-YUXIAOR-PC: pms
Xxx-Yuxiaor-Token: {{yxr-token}}

{
    "itemList":[{
        "contractId": 669769
    }],
    "redirectUrl":"http://www.yuxiaor.com"
}


### 公寓端登录(admin)
# @name getAdmYxrToken
POST {{yuxiaor-host}}/api/v1/sys/multi/userLogin
Content-Type: application/json
XXX-YUXIAOR-PC: pms

{"mobile":13818857638,"password":"123456","type":1}


### 获取批量意愿签署URL
@yxr-admin-token = {{getAdmYxrToken.response.body.$.access_token}}
GET {{yuxiaor-host}}/api/v1/orgsign/test/getSpecInvoiceTaxPres/83029
Content-Type: application/json
XXX-YUXIAOR-PC: pms
Xxx-Yuxiaor-Token: {{yxr-admin-token}}