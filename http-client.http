
# 环境变量
## @event = g6
@yuxiaor-host = http://www{{event}}.yuxiaor.com
@api-host = http://api{{event}}.yuxiaor.com
@api-token = 302fd077e9c04e95932d0d10f43f6cdb-20260818173053-243838-0
@tapp-contract-id = 670209

## 身份信息比对
### 阿里企业信息查询(企业名称)
GET https://busiinfo.market.alicloudapi.com/getbusinessinfo HTTP/1.1
Accept: application/json
Authorization: {{ali-token}}
Content-Type: application/x-www-form-urlencoded

keyword=宁波中甬为家房地产经纪有限公司

### 阿里企业信息查询(企业号)
GET https://busiinfo.market.alicloudapi.com/getbusinessinfo HTTP/1.1
Accept: application/json
Authorization: {{ali-token}}
Content-Type: application/x-www-form-urlencoded

keyword=12440300081888813E

### 阿里个人二要素比对
POST http://eid.shumaidata.com/eid/check HTTP/1.1
Accept: application/json
Authorization: {{ali-token}}
Content-Type: application/x-www-form-urlencoded

name=贾聿宁&idcard=141030200104090028


### CRM登录
# @name getCrmToken
POST {{api-host}}/crm-server/login
Content-Type: application/json
YXR-platform: h5

{
  "tel": "13761687434",
  "password": "{{password}}",
  "autoLoginFlag": 1
}

### e-sign企业三要素比对
@crm-token = {{getCrmToken.response.body.$.token}}
POST {{api-host}}/crm-server/esign-repair/sign/orgAuthVerify
Content-Type: application/json
Yxr-Pms-Crm-Token: {{crm-token}}
YXR-platform: h5

{
  "name": "宁波中甬为家房地产经纪有限公司",
  "orgCode": "91330212MAKHGA1F2Y",
  "legalRepName":"盖双",
  "channel": 3,
  "source": 1
}

### e-sign个人二要素比对
@crm-token = {{getCrmToken.response.body.$.token}}
POST {{api-host}}/crm-server/esign-repair/sign/personAuthVerify
Content-Type: application/json
Yxr-Pms-Crm-Token: {{crm-token}}
YXR-platform: h5

{
  "name": "贾聿宁",
  "idnum": "141030200104090028",
  "channel": 3,
  "source": 1
}

### 电子合同pdf重新盖章
@crm-token = {{getCrmToken.response.body.$.token}}
POST {{api-host}}/crm-server/contract-repair/repair
Content-Type: application/json
Yxr-Pms-Crm-Token: {{crm-token}}
YXR-platform: h5

{
  "contractIds": [
   111045089
  ],
  "updateFlag": 0
}

### 创建企业电子账号
@crm-token = {{getCrmToken.response.body.$.token}}
POST {{api-host}}/crm-server/esign-repair/sign/createAccount
Content-Type: application/json
Yxr-Pms-Crm-Token: {{crm-token}}
YXR-platform: h5

{
  "userId":"500000000000000004",
  "userType":"1",
  "userName":"淳飞信息科技(上海)有限公司",
  "mobile":"",
  "idNumber":"",
